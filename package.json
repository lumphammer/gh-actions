{
  "name": "@lumphammer/gh-actions",
  "scripts": {
    "lint:check": "oxlint --type-aware --report-unused-disable-directives-severity=error .github",
    "lint:fix": "oxlint --type-aware --report-unused-disable-directives-severity=error --fix .github",
    "format:check": "oxfmt --check",
    "format": "oxfmt",
    "build-actions": "./scripts/build-actions.sh",
    "typecheck": "tsc --noEmit",
    "postinstall": "pnpm run build-actions"
  },
  "type": "module",
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "chalk": "^6.0.1",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "dependencies": {
    "fs-extra": "^11.4.1"
  }
}
